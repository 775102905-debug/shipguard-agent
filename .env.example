APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
VITE_API_BASE=http://127.0.0.1:8000

# LLM 审查 Agent 配置（可选）
# LLM_REVIEW_ENABLED=false
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=replace_with_your_llm_api_key
# LLM_TIMEOUT_SECONDS=20
# LLM_DEFAULT_MODEL=gpt-4o-mini
# STUDENT_REVIEW_MODEL=
# GITHUB_REVIEW_MODEL=
# INTERVIEW_REVIEW_MODEL=
# COMMERCIAL_REVIEW_MODEL=

# LLM Guard 配置（可选）
# LLM_GUARD_ENABLED=false
# LLM_GUARD_BLOCK_ON_HIGH_RISK=true

# Prometheus Metrics 配置（可选）
# METRICS_ENABLED=true

# MCP Server 配置（可选）
# MCP_ENABLED=false
# MCP_SAFE_UPLOAD_DIR=examples
# MCP_MAX_ZIP_MB=50

# History Store 配置（可选）
# HISTORY_ENABLED=true
# HISTORY_AUTO_SAVE=false

# Knowledge Base / Safe RAG 配置（可选）
# KNOWLEDGE_ENABLED=false
# KNOWLEDGE_AUTO_INDEX=false
# KNOWLEDGE_INDEX_PATH=data/knowledge_index
# KNOWLEDGE_MAX_RESULTS=5
# KNOWLEDGE_USE_LLAMAINDEX=false
